# Copia este archivo como .env.local y llena los valores. NUNCA subas .env.local.

# Llave del API de Pey (portal.mipey.mx → Developer → Create API Key).
PEY_API_KEY=

# Secreto del webhook (portal.mipey.mx → Developer → engrane de la llave → Create Webhook).
# Empieza con whsec_
PEY_WEBHOOK_SECRET=

# Opcional. Por defecto https://api.pey.mx
# PEY_API_URL=

# Almacén de cobros (Upstash Redis). En Vercel los pone solo la integración.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# PIN del mostrador (4 a 8 números). Sin él la app queda cerrada.
PIN_MOSTRADOR=

# Secreto para firmar la sesión del mostrador (texto largo al azar, mínimo 32 caracteres).
SESION_SECRETO=

# Opcional. Dirección pública HTTPS de la app: va en los enlaces que se mandan a los
# clientes y es a donde Pey los regresa después de pagar. Por omisión https://ya-cayo.vercel.app
# APP_PUBLICA=
