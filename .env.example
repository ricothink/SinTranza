# Copia este archivo como .env.local y llena los valores. NUNCA subas .env.local.

# Llave del API de Pey (portal.mipey.mx → Developer → Create API Key).
PEY_API_KEY=

# Secreto del webhook (portal.mipey.mx → Developer → engrane de la llave → Create Webhook).
# Empieza con whsec_
PEY_WEBHOOK_SECRET=

# Opcional. Por defecto https://api.pey.mx
# PEY_API_URL=

# Almacén de cobros (Upstash Redis). En Vercel los pone solo la integración.
KV_REST_API_URL=
KV_REST_API_TOKEN=
